@model Treasury
<h1>Held payments</h1>
<p class="lead">Releasing a payment sends money out. <span class="ab-sensitive-tag">NEEDS STEP-UP</span></p>
<table class="ab-table">
  <tr><th>Id</th><th>To</th><th>Amount</th><th>Status</th><th></th></tr>
  @foreach (var p in Model.Payments()) {
    <tr><td>@p.Id</td><td>@p.To</td><td>@p.Amount.ToString("C0", new System.Globalization.CultureInfo("en-IE"))</td><td>@p.Status</td>
    <td>@if (p.Status == "held") { <form method="post" asp-action="Release"><input type="hidden" name="id" value="@p.Id" /><button class="ab-btn primary">Release</button></form> }</td></tr>
  }
</table>
