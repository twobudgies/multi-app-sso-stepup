# Copy to .env and adjust. Placeholders only: never put real secrets or tenant IDs here.
# Ports are chosen to avoid macOS AirPlay (5000/5001) and a common Docker 8080 clash.

# --- IdP (see docs/idp-adapter.md) ---
IDP_PROFILE=keycloak
IDP_ISSUER=http://localhost:8180/realms/stepup
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-dev-only
KEYCLOAK_HTTP_PORT=8180

# --- Clients ---
APP_MVC_CLIENT_SECRET=change-me-dev-only
API_AUDIENCE=stepup-api

# --- Step-up policy ---
STEPUP_MAX_AGE_SECONDS=60
STEPUP_CLOCK_SKEW_SECONDS=5

# --- Local ports ---
API_PORT=5100
MVC_PORT=5200
REACT_PORT=5300
ANGULAR_PORT=5400
