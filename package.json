{
  "name": "multi-app-sso-stepup",
  "private": true,
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "reset": "docker compose down -v && docker compose up -d",
    "dev:api": "dotnet run --project api",
    "probe": "node tools/login-probe.mjs",
    "dev:react": "npm --prefix apps/react run dev",
    "install:all": "npm --prefix apps/react install && npm --prefix apps/angular install",
    "dev:mvc": "dotnet run --project apps/mvc",
    "dev:angular": "npm --prefix apps/angular start",
    "check:evaluator": "dotnet run --project tools/evaluator-check",
    "idp-check": "node tools/idp-check/index.mjs"
  }
}